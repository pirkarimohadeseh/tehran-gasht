<style>

:root {
  --purple-dark: #32134F;
  --purple: #6F2C91;
  --purple-main: #7B3FA1;
  --purple-light: #EDE2F3;
  --purple-soft: #F8F3FA;

  --gold: #C8A64B;
  --gold-light: #E4D08A;

  --white: #FFFFFF;
  --cream: #FCFAFD;

  --text: #29212F;
  --text-light: #665D6C;

  --line: rgba(111,44,145,.14);

  --font: "Vazirmatn", Tahoma, Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--text);
  font-family: var(--font);
  line-height: 2;
}


/* =====================================================
   HERO SLIDER
===================================================== */

.hero-slider {
  position: relative;
  height: 650px;
  min-height: 560px;
  overflow: hidden;
  background: var(--purple-dark);
}


/* Slides */

.slide {
  position: absolute;
  inset: 0;

  opacity: 0;

  transition:
    opacity 1s ease,
    transform 6s ease;

  transform: scale(1.04);

  background-size: cover;
  background-position: center;
}

.slide.active {
  opacity: 1;
  transform: scale(1);
}


/* Images */

.slide:nth-child(1) {
  background-image:
    linear-gradient(
      180deg,
      rgba(50,19,79,.35),
      rgba(50,19,79,.88)
    ),
    url("https://commons.wikimedia.org/wiki/Special:FilePath/Chitgar_Lake_20190324_01.jpg?width=1600");
}

.slide:nth-child(2) {
  background-image:
    linear-gradient(
      180deg,
      rgba(50,19,79,.28),
      rgba(50,19,79,.88)
    ),
    url("https://www.irandestination.com/wp-content/uploads/2020/11/Chitgar-lake.jpg");
}

.slide:nth-child(3) {
  background-image:
    linear-gradient(
      180deg,
      rgba(50,19,79,.30),
      rgba(50,19,79,.90)
    ),
    url("https://gulfcitypedia.com/wp-content/uploads/2024/07/2.jpg");
}


/* Decorative pattern */

.hero-slider::before {
  content: "";
  position: absolute;
  inset: 0;

  z-index: 2;
  pointer-events: none;

  background:
    linear-gradient(
      135deg,
      transparent 0 48%,
      rgba(228,208,138,.09) 48% 48.2%,
      transparent 48.2%
    );

  opacity: .8;
}


/* Hero content */

.hero-content {
  position: relative;

  z-index: 5;

  height: 100%;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;

  padding: 40px 24px;

  color: white;
}


.eyebrow {
  display: inline-block;

  margin-bottom: 22px;

  padding: 6px 18px;

  border: 1px solid rgba(228,208,138,.65);

  border-radius: 50px;

  color: var(--gold-light);

  background: rgba(255,255,255,.06);

  font-size: 13px;

  font-weight: 600;
}


.hero-content h1 {
  margin: 0 0 18px;

  font-size: clamp(2.3rem, 6vw, 4.6rem);

  font-weight: 800;

  line-height: 1.45;

  text-shadow:
    0 5px 25px rgba(0,0,0,.25);
}


.hero-content p {
  max-width: 680px;

  margin: 0 auto;

  color: #F1EAF5;

  font-size: 1.05rem;

  line-height: 2.2;

  font-weight: 300;
}


.hero-line {
  width: 130px;

  height: 2px;

  margin-top: 32px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--gold),
      transparent
    );
}


/* =====================================================
   SLIDER CONTROLS
===================================================== */

.slider-btn {
  position: absolute;

  z-index: 10;

  top: 50%;

  transform: translateY(-50%);

  width: 48px;
  height: 48px;

  border: 1px solid rgba(255,255,255,.35);

  border-radius: 50%;

  background: rgba(50,19,79,.45);

  color: white;

  font-size: 22px;

  cursor: pointer;

  backdrop-filter: blur(5px);

  transition: .25s ease;
}


.slider-btn:hover {
  background: var(--purple);

  border-color: var(--gold-light);
}


.prev {
  right: 25px;
}

.next {
  left: 25px;
}


/* Dots */

.slider-dots {
  position: absolute;

  z-index: 10;

  bottom: 28px;

  left: 50%;

  transform: translateX(-50%);

  display: flex;

  gap: 9px;

  direction: ltr;
}


.dot {
  width: 9px;
  height: 9px;

  border-radius: 50%;

  border: none;

  background: rgba(255,255,255,.5);

  cursor: pointer;

  transition: .3s ease;
}


.dot.active {
  width: 28px;

  border-radius: 20px;

  background: var(--gold-light);
}


/* =====================================================
   INTRO
===================================================== */

.intro {
